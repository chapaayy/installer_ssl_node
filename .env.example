# Required: public domain served by Caddy.
DOMAIN=

# Required: ACME account email used by Caddy.
ACME_EMAIL=

# Required: node display name used for panel registration.
NODE_NAME=

# Runtime timezone.
TZ=Europe/Berlin

# Remnanode.
NODE_PORT=2222
SECRET_KEY=

# Panel auto-registration. PANEL_API_TOKEN is secret.
PANEL_DOMAIN=
PANEL_API_TOKEN=
PANEL_CONFIG_PROFILE_UUID=
PANEL_CONFIG_PROFILE_NAME=
PANEL_ACTIVE_INBOUND_UUIDS=

# Optional panel/runtime settings.
PANEL_AUTO_REGISTER_NODE=1
PANEL_NODE_UUID=
PANEL_NODE_ADDRESS=
PANEL_NODE_COUNTRY_CODE=XX
PANEL_PROVIDER_UUID=

# Remnanode image. Caddy is fixed to caddy:2 in the Compose template.
REMNANODE_IMAGE=remnawave/node:latest

# Runtime logging.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
